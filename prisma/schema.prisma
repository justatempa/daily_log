// Prisma schema for SQLite

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  password   String
  role       String   @default("USER")
  secretKey  String?
  memosToken String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  logs        Log[]
  quickTags   QuickTag[]
  aiProviders AiProvider[]
  aiSetting   AiSetting?
  aiCallLogs  AiCallLog[]
  logImages   LogImage[]
}

model Log {
  id        String   @id @default(cuid())
  userId    String
  /// 客户端生成的幂等键：同一消息重发复用，避免重复插入
  clientId  String?  @unique
  content   String
  date      DateTime
  tags      String
  isTodo    Boolean  @default(false)
  isTodoDone Boolean @default(false)
  /// 日志来源标记：AI_SUMMARY = 由 AI 总结生成（重新总结时会被替换）
  source    String?

  parentId String?
  parent   Log?     @relation("LogComments", fields: [parentId], references: [id])
  replies  Log[]    @relation("LogComments")

  /// 该条日志附带的图片（排序由 sortOrder 维护）
  images   LogImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

/// 日志图片：同一张图在磁盘上保留「原图 / 压缩图 / 缩略图」三份
/// - original：上传的原始文件，供「查看原图」使用
/// - medium：长边压到 1600 的 webp，详情预览默认用它
/// - thumb：长边 480 的 webp，列表/输入区缩略图
model LogImage {
  id String @id @default(cuid())

  userId String
  /// 未附加到任何日志时为空（上传完成但日志还没发出）
  logId String?

  /// 原始文件名，仅用于展示与无障碍文案
  name String
  /// 原图的 MIME 类型（原图按原样保存，不转码）
  mime String
  /// 原图字节数
  size Int
  /// 压缩图字节数
  mediumSize Int
  /// 原图（按 EXIF 方向校正后）的显示宽高，用于前端占位比例
  width  Int
  height Int

  /// 相对上传根目录的路径，统一正斜杠分隔，如 images/2026/11/xxx-orig.jpg
  originalPath String
  mediumPath   String
  thumbPath    String

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  log  Log? @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([logId])
  @@index([logId, sortOrder])
}

model QuickTag {
  id           String   @id @default(cuid())
  userId       String
  label        String
  categoryName String
  /// 展示顺序：数值越小越靠前；由「快捷输入管理」中的排序操作维护
  sortOrder    Int      @default(0)
  /// 是否在主页面上隐藏（管理弹窗中仍可见，可随时取消隐藏）
  hidden       Boolean  @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

/// 用户配置的 AI 提供商（OpenAI 兼容接口），按创建顺序依次尝试
model AiProvider {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// 接口根地址，例如 https://api.deepseek.com/v1，也可直接填 /chat/completions 完整地址
  baseUrl   String
  apiKey    String
  model     String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 每个用户的 AI 总结配置
model AiSetting {
  id             String   @id @default(cuid())
  userId         String   @unique
  /// 总结提示词，支持 {{date}} / {{logs}} 占位符
  prompt         String
  /// 是否开启每日自动总结
  autoEnabled    Boolean  @default(true)
  timezone       String   @default("Asia/Shanghai")
  scheduleHour   Int      @default(0)
  scheduleMinute Int      @default(30)
  /// 已触发自动总结的日期（该时区的 YYYY-MM-DD），用于避免同一天重复触发
  lastAutoRunDay String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// AI 调用历史：一次总结会为每个尝试过的提供商各写一条
model AiCallLog {
  id           String    @id @default(cuid())
  userId       String
  /// 同一次总结（含顺序尝试多个提供商）共享同一个 runId
  runId        String
  /// 被总结日期的本地零点（instant）
  targetDate   DateTime?
  /// 被总结日期 YYYY-MM-DD（便于展示与去重）
  targetDay    String?
  /// AUTO=定时自动，MANUAL=手动生成，TEST=测试连通性
  trigger      String
  providerId   String?
  providerName String
  model        String
  /// SUCCESS / FAILED
  status       String
  error        String?
  content      String?
  inputChars   Int       @default(0)
  durationMs   Int       @default(0)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
